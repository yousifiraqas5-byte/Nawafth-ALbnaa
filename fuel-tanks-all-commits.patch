+    const tanks = {};
+    let total = 0;
+    for (const def of fuelDlColumns()) {
+        const raw = ((document.getElementById("fuelDlQty_" + def.id) || {}).value || "").trim();
+        if (raw === "") continue;
+        const p = FuelCalc.parseInput(raw);
