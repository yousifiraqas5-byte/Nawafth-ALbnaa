+    if (!fuelEngineReady()) return;
+
+    const data = readFuelDlForm();
+    if (!data) return;
+    const db = getFirestoreDB();
+    if (!db) return;
+
+    const who = fuelWho();
+    const editingId = fuelDlEditingId;
+    fuelDlSaving = true;
+    const btn = document.getElementById("fuelDlSave");
+    if (btn) btn.disabled = true;
+
+    try {
+        const fs = await import(FUEL_FIRESTORE_URL);
+        if (editingId) {
+            await withFuelTimeout(fs.updateDoc(fs.doc(db, FUEL_DELIVERIES_COLLECTION, editingId), Object.assign({}, data, {
+                updatedAt: fs.serverTimestamp(), updatedBy: who
+            })), FUEL_SAVE_TIMEOUT_MS);
+        } else {
+            await withFuelTimeout(fs.addDoc(fs.collection(db, FUEL_DELIVERIES_COLLECTION), Object.assign({}, data, {
+                createdAt: fs.serverTimestamp(), createdBy: who
