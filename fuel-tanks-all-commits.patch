+// قراءة قيم النموذج مع التحقق (null عند وجود خطأ بعد إظهار الرسالة)
+function readFuelDlForm() {
+    const date = (document.getElementById("fuelDlDate") || {}).value || "";
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
