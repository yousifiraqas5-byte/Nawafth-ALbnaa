+    if (open) {
+        renderFuelDeliveries();
+        getFuelDeliveries();
+    }
+}
+
+async function getFuelDeliveries(force) {
+    if (fuelDeliveriesLoading) return;
+    if (!force && fuelDeliveriesLoaded) return;
+    const db = getFirestoreDB();
+    if (!db) return;
+
+    fuelDeliveriesLoading = true;
+    try {
+        const fs = await import(FUEL_FIRESTORE_URL);
+        const q = fs.query(
+            fs.collection(db, FUEL_DELIVERIES_COLLECTION),
+            fs.orderBy("date", "asc"),
+            fs.limit(FUEL_DELIVERIES_LIMIT)
+        );
+        const snap = await fs.getDocs(q);
+        const rows = [];
