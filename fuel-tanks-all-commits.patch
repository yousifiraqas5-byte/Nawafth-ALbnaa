 // ============================================================
 
+// ============================================================
+// جدول توريد الكاز: سجل الحمولات الواصلة وتوزيع كل حمولة على الخزانات
+// fuelDeliveries/{auto}: { date: "YYYY-MM-DD", driver, tanks: { [tankId]: لتر },
