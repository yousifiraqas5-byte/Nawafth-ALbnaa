+// ============================================================
+
+const FUEL_DELIVERIES_COLLECTION = "fuelDeliveries";
+const FUEL_DELIVERIES_LIMIT = 1000;
+const FUEL_DELIVERY_MAX_L = 1000000;
+// ترتيب أعمدة الخزانات (من اليمين إلى اليسار) كما في الجدول الورقي
+const FUEL_DELIVERY_COLUMNS = ["tank1", "tank2", "tank3", "complexGenerator", "boiler1", "boiler2", "hospitalGenerator"];
+
+let fuelDeliveries = [];
+let fuelDeliveriesLoaded = false;
+let fuelDeliveriesFailed = false;
+let fuelDeliveriesLoading = false;
+let fuelDlEditingId = null;
+let fuelDlSaving = false;
+
+function fuelDlColumns() {
+    return FUEL_DELIVERY_COLUMNS.map(fuelFindDef).filter(Boolean);
+}
+
+function fuelTodayString() {
+    const d = new Date();
+    return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
+}
+
+function fuelDlDateText(value) {
+    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(value || ""));
+    return m ? m[3] + "/" + m[2] + "/" + m[1] : "—";
+}
+
+// التبديل بين لوحة الخزانات وجدول التوريد (داخل نفس الصفحة)
+function showFuelView(view) {
+    const dash = document.getElementById("fuelDashboardView");
+    const dl = document.getElementById("fuelDeliveriesView");
+    const btn = document.getElementById("fuelDlToggle");
+    const deliveries = view === "deliveries";
+    if (dash) dash.hidden = deliveries;
+    if (dl) dl.hidden = !deliveries;
+    if (btn) btn.textContent = deliveries ? "🛢️ لوحة الخزانات" : "📋 جدول التوريد";
+}
+
+function toggleFuelDeliveries() {
