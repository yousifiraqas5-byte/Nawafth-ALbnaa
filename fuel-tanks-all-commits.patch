+            '<div class="fuel-muted">الكمية الواصلة لكل خزان (لتر) — اترك الخزانات التي لم تستلم فارغة:</div>' +
+            '<div class="fuel-dl-qty-grid">' + inputs + '</div>' +
+            '<div class="fuel-dl-total">الكمية الواصلة (المجموع): <strong id="fuelDlTotal">0</strong> لتر</div>' +
