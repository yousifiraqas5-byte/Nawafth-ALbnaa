rules_version = '2';

// ============================================================
// قواعد Firestore لتطبيق شركة نوافذ البناء
// ------------------------------------------------------------
// السياسة المطبَّقة هنا تطابق منطق التطبيق في script.js:
//
// 1) القراءة (read): مفتوحة لكل الزوار.
//    السبب: التصفح والعرض في التطبيق متاحان بدون تسجيل دخول
//    (الصفحة الرئيسية / المشتريات / التقارير / المهام / الجرد /
//    الأعطال). إغلاق القراءة سيُعطّل التطبيق لغير المسجّلين.
//
// 2) الكتابة (write): لا تتم إلا لمستخدم مسجّل الدخول.
//    السبب: كل عمليات الإضافة/التعديل/الحذف في script.js تبدأ
//    بالحماية requireLoginForWrite(...) قبل الوصول إلى Firestore.
//
// لا توجد أي قاعدة من نوع "allow read, write: if true;" —
// الكتابة مقصورة على request.auth != null فقط.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // هل الطلب صادر عن مستخدم مسجّل الدخول؟
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // المحرّر الوحيد لقسم خزانات الكاز (الباقون قراءة فقط)
    function isFuelEditor() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'yousif.altaee9@gmail.com';
    }

    // المشتريات
    match /purchases/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // التقارير اليومية
    match /reports/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // مهام المهندسين
    match /tasks/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // مواد المخازن والمطبخ (إضافة/سحب)
    match /materials/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // سجل الإشعارات
    match /notifications/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // رموز الأجهزة المسجلة للإشعارات
    match /notificationTokens/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // الأجهزة الطبية (الأعطال)
    match /medical_device_faults/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // سجلات صيانة الأجهزة الطبية (سحب ملف Excel)
    match /medical_device_maintenance/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // عداد التذاكر (Ticket ID Counter)
    match /counters/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // كميات خزانات الكاز (Fuel Tanks) — الكتابة للمحرّر الوحيد فقط
    match /fuelTanks/{documentId} {
      allow read: if true;
      allow write: if isFuelEditor();
    }

    // سجل قراءات خزانات الكاز (إضافة وإنشاء؛ الحذف مسموح للمحرّر الوحيد لإزالة قراءة خاطئة)
    match /fuelTankReadings/{documentId} {
      allow read: if true;
      allow create: if isFuelEditor();
      allow update: if false;
      allow delete: if isFuelEditor();
    }

    // جدول توريد الكاز (الحمولات الواصلة) — الكتابة للمحرّر الوحيد فقط
    match /fuelDeliveries/{documentId} {
      allow read: if true;
      allow write: if isFuelEditor();
    }

    // مواقع الأجهزة الطبية (Location) — تُنشأ تلقائياً عند أول حفظ
    match /medical_locations/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ==========================================================
    // قسم الميكانيك — قراءة مفتوحة، كتابة للمستخدم المسجّل فقط
    // (نفس سياسة بقية الأقسام: الحماية الفعلية requireLoginForWrite
    //  في script.js، وهنا تُقيَّد الكتابة على request.auth != null)
    // ==========================================================

    // سجل المعدات والأصول الميكانيكية
    match /mechanical_equipment/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // أوامر العمل والأعطال
    match /mechanical_work_orders/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // سجل تغيّر حالات أوامر العمل (إضافة فقط لضمان سلامة الأثر)
    match /mechanical_work_order_history/{documentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // خطط الصيانة الوقائية
    match /mechanical_pm_plans/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // سجل تنفيذ عمليات الصيانة الوقائية (إضافة فقط)
    match /mechanical_pm_logs/{documentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // قطع الغيار المطلوبة والمستخدمة
    match /mechanical_spares/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // عدّاد أرقام أوامر العمل
    match /mechanical_counters/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // سجل أنواع المعدات والكميات المعتمدة (بما فيها مكافحة الحريق)
    match /mechanical_equipment_types/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ابنية المستشفى (الطوابق والبنايات: حالة وملاحظات)
    match /hospital_buildings/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

  }
}