# شركة نوافذ البناء - إعدادات موحّدة لمنع تلف الترميز
# سبب الإضافة: تحوّل النصوص العربية في script.js إلى علامات استفهام (?) بسبب
# حفظ الملف بترميز Windows-1252 (ANSI) بدل UTF-8. هذه الإعدادات تفرض UTF-8.
root = true

[*]
charset = utf-8
end_of_line = crlf

[*.js]
charset = utf-8

[*.html]
charset = utf-8

[*.css]
charset = utf-8

[*.json]
charset = utf-8